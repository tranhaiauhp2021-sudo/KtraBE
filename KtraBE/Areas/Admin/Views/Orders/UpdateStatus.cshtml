@model KtraBE.Models.UpdateOrderStatusVM
@{
    ViewBag.Title = "Cập nhật trạng thái đơn hàng #" + Model.OrderID;
}
<div class="page-heading">
    <div><div class="eyebrow">QUẢN TRỊ / CẬP NHẬT TRẠNG THÁI</div>
        <h1>Cập nhật đơn hàng #@Model.OrderID</h1>
        <p class="muted">Khách hàng: @Model.CustomerName</p></div>
</div>
<div class="edit-panel">
    @using (Html.BeginForm("UpdateStatus", "Orders", new { area = "Admin" }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.OrderID)
        @Html.ValidationSummary(true, "", new { @class = "validation" })
        <div class="form-group">
            @Html.LabelFor(m => m.OrderStatus)
            @Html.DropDownListFor(m => m.OrderStatus, (SelectList)ViewBag.OrderStatusOptions, "-- Chọn trạng thái --", new { @class = "input" })
            @Html.ValidationMessageFor(m => m.OrderStatus, "", new { @class = "validation" })
        </div>
        <div class="form-group">
            @Html.LabelFor(m => m.PaymentStatus)
            @Html.DropDownListFor(m => m.PaymentStatus, (SelectList)ViewBag.PaymentStatusOptions, "-- Chọn trạng thái --", new { @class = "input" })
            @Html.ValidationMessageFor(m => m.PaymentStatus, "", new { @class = "validation" })
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" type="submit">Lưu trạng thái</button>
            <a class="btn btn-light" href="@Url.Action("Details", "Orders", new { area = "Admin", id = Model.OrderID })">Hủy và quay lại</a>
        </div>
    }
</div>
