@using System.Linq
@model KtraBE.Models.OrderSearchVM
@{
    ViewBag.Title = "Danh sách đơn hàng";
}
<div class="page-heading">
    <div>
        <div class="eyebrow">QUẢN TRỊ / ĐƠN HÀNG</div>
        <h1>Quản lý đơn hàng</h1>
        <p class="muted">Tra cứu đơn hàng của khách hàng và xem chi tiết hóa đơn.</p>
    </div>
    <div class="stat-pill"><span>@Model.TotalCount</span> đơn hàng phù hợp</div>
</div>

<section class="search-panel" aria-label="Tìm kiếm đơn hàng">
    @using (Html.BeginForm("Index", "Orders", new { area = "Admin" }, FormMethod.Get, new { @class = "search-grid" }))
    {
        <div class="form-group">
            <label for="customerName">Tên khách hàng</label>
            <input class="input" id="customerName" name="customerName" type="text" value="@Model.CustomerName" placeholder="Nhập tên khách hàng..." />
        </div>
        <div class="form-group">
            <label for="paymentStatus">Trạng thái thanh toán</label>
            <select class="input" id="paymentStatus" name="paymentStatus">
                <option value="">Tất cả trạng thái</option>
                <option value="Chưa thanh toán" @(Model.PaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                <option value="Đã thanh toán" @(Model.PaymentStatus == "Đã thanh toán" ? "selected" : "")>Đã thanh toán</option>
                <option value="Đã hoàn tiền" @(Model.PaymentStatus == "Đã hoàn tiền" ? "selected" : "")>Đã hoàn tiền</option>
            </select>
        </div>
        <div class="form-group">
            <label for="orderDate">Ngày đặt hàng</label>
            <input class="input" id="orderDate" name="orderDate" type="date" value="@(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="form-group actions">
            <button type="submit" class="btn btn-primary">🔎 Tìm kiếm</button>
            <a class="btn btn-light" href="@Url.Action("Index", "Orders", new { area = "Admin" })">Xóa lọc</a>
        </div>
    }
</section>

<section class="list-panel">
    <div class="section-title"><h2>DANH SÁCH ĐƠN HÀNG</h2><span>15 đơn / trang</span></div>
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng giá trị</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Phương thức giao hàng</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Orders.Any())
            {
                <tr><td colspan="7" class="no-results">KHÔNG CÓ ĐƠN HÀNG PHÙ HỢP</td></tr>
            }
            else
            {
                foreach (var order in Model.Orders)
                {
                    <tr>
                        <td class="strong">#@order.OrderID</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@order.Customer.CustomerName</td>
                        <td class="price">@String.Format("{0:N0} ₫", order.TotalAmount)</td>
                        <td>
                            <span class="status @(order.PaymentStatus == "Đã thanh toán" ? "paid" : order.PaymentStatus == "Đã hoàn tiền" ? "refunded" : "pending")">@order.PaymentStatus</span>
                        </td>
                        <td>@order.DeliveryMethod</td>
                        <td><a class="details-link" href="@Url.Action("Details", "Orders", new { area = "Admin", id = order.OrderID })">Chi tiết đơn hàng →</a></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
    @if (Model.TotalCount > 0)
    {
        <div class="pagination-bar">
            <span>Đang hiển thị @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) / @Model.TotalCount đơn</span>
            <div class="page-controls">
                @if (Model.Page > 1)
                {
                    <a href="@Url.Action("Index", "Orders", new { area = "Admin", customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("yyyy-MM-dd") : null, page = Model.Page - 1 })">‹</a>
                }
                @for (int p = 1; p <= Model.PageCount; p++)
                {
                    if (p == 1 || p == Model.PageCount || Math.Abs(p - Model.Page) <= 2)
                    {
                        <a class="@(p == Model.Page ? "current" : "")" href="@Url.Action("Index", "Orders", new { area = "Admin", customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("yyyy-MM-dd") : null, page = p })">@p</a>
                    }
                    else if (p == 2 && Model.Page > 4 || p == Model.PageCount - 1 && Model.Page < Model.PageCount - 3)
                    {
                        <span>…</span>
                    }
                }
                @if (Model.Page < Model.PageCount)
                {
                    <a href="@Url.Action("Index", "Orders", new { area = "Admin", customerName = Model.CustomerName, paymentStatus = Model.PaymentStatus, orderDate = Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("yyyy-MM-dd") : null, page = Model.Page + 1 })">›</a>
                }
            </div>
        </div>
    }
</section>
