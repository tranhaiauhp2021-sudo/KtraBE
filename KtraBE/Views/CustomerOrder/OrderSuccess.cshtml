@model KtraBE.Models.Order
@{ ViewBag.Title = "Đặt hàng thành công"; }
<div class="shop-success"><div class="shop-success-icon">✓</div><span class="shop-tag">ORDER CONFIRMED</span><h1>Đặt hàng thành công!</h1><p>Cảm ơn bạn đã mua hàng. Đơn <strong>#@Model.OrderID</strong> đã được lưu vào hệ thống.</p><div class="shop-success-details"><div><span>Ngày đặt</span><strong>@Model.OrderDate.ToString("dd/MM/yyyy")</strong></div><div><span>Trạng thái</span><strong>@Model.OrderStatus</strong></div><div><span>Thanh toán</span><strong>@Model.PaymentStatus</strong></div><div><span>Tổng giá trị</span><strong>@Model.TotalAmount.ToString("N0") ₫</strong></div></div><div class="shop-success-actions"><a class="shop-btn shop-btn-dark" href="@Url.Action("OrderHistory","CustomerOrder")">Đơn hàng của tôi</a><a class="shop-btn shop-btn-light" href="@Url.Action("Index","Home")">Tiếp tục mua sắm</a></div></div>
