@model KtraBE.Models.LoginVM
@{ ViewBag.Title = "Đăng nhập khách hàng"; }
<div class="shop-form-wrap"><span class="shop-tag">CHÀO MỪNG TRỞ LẠI</span><h1>Đăng nhập khách hàng</h1><p>Đăng nhập để đặt hàng và theo dõi đơn mua.</p>
@using(Html.BeginForm("Login","CustomerAccount",FormMethod.Post,new { @class="shop-form" }))
{
    @Html.AntiForgeryToken() @Html.ValidationSummary(true,"",new { @class="shop-errors" })
    <label>Tên đăng nhập @Html.TextBoxFor(m=>m.Username) @Html.ValidationMessageFor(m=>m.Username)</label>
    <label>Mật khẩu @Html.PasswordFor(m=>m.Password) @Html.ValidationMessageFor(m=>m.Password)</label>
    <button type="submit" class="shop-btn shop-btn-dark">Đăng nhập</button>
}
<p>Chưa có tài khoản? <a href="@Url.Action("Register")">Đăng ký ngay</a></p></div>
