@model KtraBE.Models.LoginVM
@{
    ViewBag.Title = "Đăng nhập quản trị";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="login-wrap">
    <div class="login-panel">
        <div class="login-mark">FASTOR<span>•</span>STORE</div>
        <div class="eyebrow">HỆ THỐNG QUẢN TRỊ FASTOR</div>
        <h1>Đăng nhập Admin</h1>
        <p class="muted">Quản trị cửa hàng và đơn hàng</p>

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "login-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation" })
            <div class="form-group">
                @Html.LabelFor(m => m.Username)
                @Html.TextBoxFor(m => m.Username, new { @class = "input", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "validation" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "input", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "validation" })
            </div>
            <button class="btn btn-primary btn-block" type="submit">Đăng nhập vào trang quản trị</button>
        }

    </div>
    <div class="login-side">
        <div class="login-side-box">
            <div class="big-emoji">📦</div>
            <h2>Quản lý đơn hàng</h2>
            <p>Tìm kiếm, phân trang, xem chi tiết hóa đơn và cập nhật trạng thái.</p>
            <span>Hệ thống quản trị FASTOR</span>
        </div>
    </div>
</div>
